# APP ENVIRONMENT CONFIGURATION
APP_NAME="Enterprise AI Grocery Inventory Platform"
APP_ENV="production"
DEBUG=false
LOG_LEVEL="INFO"

# DATABASE CONFIGURATION
DB_HOST="db"
DB_PORT=5432
DB_NAME="grocery_prod_db"
DB_USER="grocery_admin"
DB_PASSWORD="ProductionSecurePassword123!"

# REDIS CONFIGURATION
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

# JWT SECURITY CONFIGURATION
JWT_SECRET="ProductionSuperSecretJWTKey987654321!"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# STORAGE CONFIGURATION
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="/app/local_storage"

# AI INFERENCE THRESHOLDS
YOLO_BASE_MODEL="yolo11m.pt"
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_IOU_THRESHOLD=0.45
OCR_LANGUAGES="en"

# FRONTEND CONFIGURATION
NEXT_PUBLIC_API_URL="http://localhost:8000"
